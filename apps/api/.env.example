# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║              MONEY FLOW API - Environment Variables (NestJS)              ║
# ║                                                                           ║
# ║  Copy this file to .env and fill in your values                          ║
# ║  NEVER commit .env to version control                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://moneyflow.mtkcodex.site

# =============================================================================
# TIDB CLOUD DATABASE
# =============================================================================
# Get these from: https://tidbcloud.com/console/clusters
# Navigate to: Clusters > Your Cluster > Connect > General

TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=moneyflow
TIDB_SSL=true

# Prisma Database URL (auto-constructed or set directly)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=VERIFY_IDENTITY
DATABASE_URL="mysql://your_tidb_username:your_tidb_password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/moneyflow?sslaccept=strict"

# =============================================================================
# SUPABASE (Authentication)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (from Supabase dashboard > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# UPSTASH REDIS (Caching)
# =============================================================================
# Get these from: https://console.upstash.com/redis
# Navigate to: Your Database > REST API

UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional: Redis URL for direct connection
REDIS_URL=rediss://default:your_token@your-redis-instance.upstash.io:6379

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_MEMORY=100mb

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_AUTH=1000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry DSN (optional) - https://sentry.io/
SENTRY_DSN=

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_TIDB=true
ENABLE_REDIS_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_SWAGGER=true

# =============================================================================
# EMAIL (Optional - for sending invoices)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@moneyflow.app

# =============================================================================
# FILE STORAGE (Optional - for invoice PDFs)
# =============================================================================
# Use Supabase Storage or S3-compatible
STORAGE_BUCKET=invoices
STORAGE_REGION=us-west-2

# =============================================================================
# DEPLOYMENT URLS
# =============================================================================
# Used for generating URLs in emails, PDFs, etc.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# Production URLs (uncomment when deploying)
# FRONTEND_URL=https://moneyflow.mtkcodex.site
# API_URL=https://api.mtkcodex.site
