{
  "name": "money-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Complete business management platform for invoicing, inventory management, and accounting",
  "keywords": [
    "invoicing",
    "inventory-management",
    "accounting",
    "business-management",
    "saas",
    "invoice-software",
    "accounting-software",
    "financial-management",
    "react",
    "typescript",
    "supabase"
  ],
  "author": "Money Flow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaashmalik/moneyflow.git"
  },
  "bugs": {
    "url": "https://github.com/Kaashmalik/moneyflow/issues"
  },
  "homepage": "https://github.com/Kaashmalik/moneyflow#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "glob": "^11.0.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:strict": "npm run type-check && npm run lint && vite build",
    "build:fast": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "preview:build": "npm run build && npm run preview",
    "clean": "npx rimraf dist node_modules/.vite .vitest coverage tests/results",
    "clean:all": "npm run clean && npx rimraf node_modules package-lock.json",
    "type-check": "npx tsc --noEmit",
    "type-check:watch": "npx tsc --noEmit --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 2500",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"*.{ts,tsx,json,md}\"",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "validate:ci": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "prepare": "husky || true",
    "postinstall": "husky || true",
    "supabase": "supabase",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration new",
    "db:status": "supabase db status",
    "db:test": "npx tsx scripts/test-supabase-connection.ts",
    "tidb:test": "node scripts/test-tidb-connection.cjs",
    "tidb:validate": "node scripts/validate-tidb-schema.cjs",
    "tidb:perf": "node scripts/test-tidb-performance.cjs",
    "tidb:partitions": "node scripts/manage-tidb-partitions.cjs status",
    "tidb:partitions:add": "node scripts/manage-tidb-partitions.cjs add",
    "migrate:export": "npx ts-node migrations/tidb-integration/scripts/export/export-all.ts",
    "migrate:import": "npx ts-node migrations/tidb-integration/scripts/import/import-all.ts",
    "migrate:validate": "npx ts-node migrations/tidb-integration/scripts/validate/validate-all.ts",
    "migrate:all": "npx ts-node migrations/tidb-integration/scripts/migrate-all.ts",
    "migrate:rollback": "npx ts-node migrations/tidb-integration/scripts/rollback.ts",
    "functions:deploy": "supabase functions deploy",
    "functions:serve": "supabase functions serve",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:update:interactive": "npm-check-updates -i",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:serve": "npx http-server storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.8",
    "@radix-ui/react-toolbar": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.85.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.15.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.344.0",
    "mysql2": "^3.15.3",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-aria-components": "^1.5.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/addon-themes": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^0.11.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jsdom": "^27.2.0",
    "lint-staged": "^15.2.10",
    "msw": "^2.6.4",
    "npm-check-updates": "^17.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "storybook": "^8.5.0",
    "supabase": "^2.58.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
