# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    MONEY FLOW - Environment Variables                      ║
# ║                                                                            ║
# ║  Copy this file to .env.local and fill in your values                     ║
# ║  NEVER commit .env.local or .env to version control                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# NEW API CONFIGURATION (TiDB Migration)
# ============================================
# NestJS API URL (Render deployment)
VITE_API_URL=http://localhost:3001
# VITE_API_URL=https://api.mtkcodex.site

# Edge API URL (Cloudflare Workers)
VITE_EDGE_API_URL=http://localhost:8787
# VITE_EDGE_API_URL=https://edge.mtkcodex.site

# ============================================
# FEATURE FLAGS - API Migration
# ============================================
# Enable new NestJS API backend
VITE_USE_NEW_API=false

# Enable TiDB database (via new API)
VITE_USE_TIDB=false

# Enable Cloudflare Edge caching
VITE_USE_EDGE_CACHE=false

# Rollout percentage (0-100) for gradual migration
VITE_NEW_API_ROLLOUT=0
VITE_TIDB_ROLLOUT=0

# Enable dual-write mode (write to both Supabase and TiDB)
VITE_ENABLE_DUAL_WRITE=false

# ============================================
# APPLICATION CONFIGURATION
# ============================================
VITE_APP_NAME=Money Flow
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS - Features
# ============================================
VITE_ENABLE_INVENTORY=true
VITE_ENABLE_MULTI_CURRENCY=true
VITE_ENABLE_MULTI_BRANCH=false
VITE_ENABLE_API_ACCESS=false
VITE_ENABLE_CUSTOM_BRANDING=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_REALTIME=true

# ============================================
# ANALYTICS (Optional)
# ============================================
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# ============================================
# ENVIRONMENT
# ============================================
# Options: development, staging, production
VITE_ENVIRONMENT=development

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# ============================================
# FILE UPLOAD LIMITS
# ============================================
# In bytes (5MB = 5242880)
VITE_MAX_FILE_SIZE=5242880
VITE_MAX_FILES_PER_UPLOAD=10

# ============================================
# SESSION CONFIGURATION
# ============================================
# In milliseconds (1 hour = 3600000)
VITE_SESSION_TIMEOUT=3600000

# ============================================
# DEBUG FLAGS
# ============================================
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_QUERY_DEVTOOLS=true
VITE_ENABLE_CONSOLE_LOGS=true

# ============================================
# MAINTENANCE MODE
# ============================================
VITE_READ_ONLY_MODE=false
VITE_MAINTENANCE_MESSAGE=