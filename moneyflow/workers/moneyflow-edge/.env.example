# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║        MONEY FLOW EDGE - Cloudflare Workers Environment Variables         ║
# ║                                                                           ║
# ║  These variables are set in wrangler.toml or Cloudflare Dashboard         ║
# ║  For local dev, create a .dev.vars file (gitignored)                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# =============================================================================
# ORIGIN API (NestJS Backend)
# =============================================================================
ORIGIN_API_URL=https://api.mtkcodex.site
# For local development:
# ORIGIN_API_URL=http://localhost:3001

# =============================================================================
# SUPABASE (Authentication)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=https://moneyflow.mtkcodex.site,http://localhost:5173

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
DEFAULT_CACHE_TTL=300
MAX_CACHE_TTL=86400

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
# ENVIRONMENT=production

# =============================================================================
# SECRETS (Set via wrangler secret put or Cloudflare Dashboard)
# =============================================================================
# These should NOT be in .env files, use:
#   wrangler secret put SUPABASE_SERVICE_KEY
#   wrangler secret put ADMIN_API_KEY

# SUPABASE_SERVICE_KEY=your-service-role-key (SET AS SECRET)
# ADMIN_API_KEY=your-admin-api-key (SET AS SECRET)
