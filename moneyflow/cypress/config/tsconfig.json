{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false
  },
  "include": [
    "../**/*.cy.ts",
    "../**/*.cy.tsx",
    "../support/**/*.ts",
    "../support/**/*.d.ts",
    "../globals.d.ts"
  ],
  "exclude": ["node_modules", "../node_modules", "../../node_modules"]
}
